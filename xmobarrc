Config { font = "xft:Monoid-Regular 10"
       , additionalFonts = []
       , bgColor = "white"
       , fgColor = "black"
       , position = Static { xpos= 12 , ypos = 12, width = 1576, height = 30 }
       , textOffset = -1
       , iconOffset = -1
       , lowerOnStart = True
       , pickBroadest = False
       , persistent = False
       , hideOnStart = False
       , iconRoot = "."
       , allDesktops = True
       , overrideRedirect = True
       , commands = [ Run Network "wlp3s0" ["-t"," ↑<tx>Kb ↓<rx>Kb"] 10
                    , Run Cpu ["-t"," <total>%"] 20
                    , Run ThermalZone 1 ["-t", "<temp>C"
                            , "-H", "70"        -- high threshold
                            , "-h", "#FF0000", "-n", "#000000"] 50
                    , Run Memory ["-t"," <used> Mb"] 20
                    , Run Date "%a %b %_d %I:%M" "date" 10
		    , Run StdinReader
		    , Run Alsa "default" "Master"
                        [ "--template", "<volumestatus>"
                        , "--suffix"  , "True"
                        , "--"
                        , "--on", " "
                        , "--off", " [muted]"
                        ]
		    , Run Battery 
                        [ "--template", "<acstatus>"       -- <acstatus> already includes the icon + % text
                        , "--Low",      "10"
                        , "--High",     "80"
                        , "--low",      "red"
                        , "--normal",   "orange"
                        , "--high",     "green"
                        , "--"
                        , "-o", "<fc=#000000></fc> <left>%"        -- discharging
                        , "-O", "<fc=#000000></fc> <fc=orange>Charging</fc>"  -- AC charging
                        , "-i", "<fc=#000000></fc> <fc=green>Charged</fc>"        -- fully charged
                        , "-a", "notify-send -u critical 'Battery running out!!'"
                        , "-A", "15"
                        ] 50
                    , Run XMonadLog

		    ]
       , sepChar = "%"
       , alignSep = "}{"
       , template = "  %cpu% %thermal1% | %memory% | %wlp3s0%} ♥  %XMonadLog%  ♥ {%alsa:default:Master% | %battery% | %date% "
       }
