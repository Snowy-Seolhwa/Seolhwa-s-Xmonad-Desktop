Config { font = "xft:Monoid-Regular 11"
       , additionalFonts = []
       , bgColor = "white"
       , fgColor = "black"
       , position = Static { xpos= 12 , ypos = 12, width = 1896, height = 36 }
       , textOffset = -1
       , iconOffset = -1
       , lowerOnStart = True
       , pickBroadest = False
       , persistent = False
       , hideOnStart = False
       , iconRoot = "."
       , allDesktops = True
       , overrideRedirect = True
       , commands = [ Run Network "wlp3s0" ["-t"," ↑<tx>Kb ↓<rx>Kb"] 10
                    , Run Cpu ["-t"," <total>%"] 20
                    , Run ThermalZone 1 ["-t", "<temp>C"
                            , "-H", "70"        -- high threshold
                            , "-h", "#FF0000", "-n", "#000000"] 50
                    , Run Memory ["-t"," <used> Mb"] 20
                    , Run Date "%a %b %_d %I:%M" "date" 10
		    , Run StdinReader
		    , Run Alsa "default" "Master"
                        [ "--template", "  <volumestatus>"
                        , "--suffix"  , "True"
                        , "--"
                        , "--on", ""
                        ]
		    , Run Battery        [ "--template" , "  <acstatus>"
                             , "--Low"      , "10"        -- units: %
                             , "--High"     , "80"        -- units: %
                             , "--low"      , "red"
                             , "--normal"   , "orange"
                             , "--high"     , "green"

                             , "--" -- battery specific options
                                       -- discharging status
                                       , "-o"	, "<left>%"
                                       -- AC "on" status
                                       , "-O"	, "<fc=orange>Charging</fc>"
                                       -- charged status
                                       , "-i"	, "<fc=green>Charged</fc>"
                             ] 50
                    , Run XMonadLog
                    
		    ]
       , sepChar = "%"
       , alignSep = "}{"
       , template = "  %cpu% %thermal1% | %memory% | %wlp3s0%} ♥  %XMonadLog%  ♥ {%alsa:default:Master% | %battery% | %date% "
       }
